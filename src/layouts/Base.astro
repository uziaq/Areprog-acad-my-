---
import '../styles/global.css';

interface Props {
  titre: string;
  description?: string;
  actif?: 'accueil' | 'parcours' | 'competences' | 'historique' | 'sauvegarde';
}
const { titre, description = 'Formation privée à l\'électronique automobile', actif } = Astro.props;
const liens = [
  { cle: 'accueil', href: '/', texte: 'Tableau de bord' },
  { cle: 'parcours', href: '/parcours/', texte: 'Parcours' },
  { cle: 'competences', href: '/competences/', texte: 'Compétences' },
  { cle: 'historique', href: '/historique/', texte: 'Historique' },
  { cle: 'sauvegarde', href: '/sauvegarde/', texte: 'Sauvegarde' },
] as const;
const titreComplet = titre === 'AREPROG Academy' ? titre : `${titre} · AREPROG Academy`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E2225" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icones/icone.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icones/icone-180.png" />
    <link rel="preload" href="/polices/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{titreComplet}</title>
  </head>
  <body>
    <a class="saut" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="entete-interne">
        <a class="marque" href="/">AREPROG <span>Academy</span></a>
        <nav class="nav" aria-label="Navigation principale">
          {liens.map((l) => (
            <a href={l.href} aria-current={actif === l.cle ? 'page' : undefined}>{l.texte}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <script>
      import { enregistrerServiceWorker } from '../lib/hors-ligne.ts';
      enregistrerServiceWorker();
    </script>
  </body>
</html>
